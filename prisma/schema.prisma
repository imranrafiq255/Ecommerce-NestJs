generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

model User {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  name     String
  password String
  role     Role    @default(USER)
  orders   Order[]
}

model Order {
  id        Int     @id @default(autoincrement())
  name      String
  quantity  Int     @default(0)
  userId    Int
  orderBy   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Product {
  id     Int     @id @default(autoincrement())
  name   String
  price  Decimal
  orders Order[]
}
